# Copy this file, save it as ".env" and fill in your keys.
# Fallback chain: Ollama (local) -> GLM -> NVIDIA -> OpenRouter -> Gemini.
# If one fails the next runs automatically; if all fail you get the database-search answer.
# The app works even if you configure nothing.

# --- 0) Ollama (LOCAL, completely free — no key needed) ---
# Install: https://ollama.com  then download a model:  ollama pull qwen2.5:7b
# qwen2.5:7b is best for 16GB RAM + 6GB GPU (good Hindi + fast).
# If RAM is short / it feels slow, use a smaller model: OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
# (A local DeepSeek model also works: OLLAMA_MODEL=deepseek-r1:7b)
# OLLAMA_NUM_CTX=8192

# --- 1) GLM (z.ai) — FREE model glm-4.7-flash ---
# Get a key here: https://z.ai/manage-apikey/apikey-list
GLM_API_KEY=
# GLM_MODEL=glm-4.7-flash
# GLM_BASE_URL=https://api.z.ai/api/paas/v4

# --- 2) NVIDIA NIM — FREE tier ---
# Get a key here: https://build.nvidia.com  (Get API Key, starts with nvapi-...)
NVIDIA_API_KEY=
# NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# TIP: to use DeepSeek for FREE, don't buy the paid DeepSeek API —
# NVIDIA's free tier offers a DeepSeek model, just set:
# NVIDIA_MODEL=deepseek-ai/deepseek-r1

# --- 3) OpenRouter — FREE ':free' models ---
# Get a key here: https://openrouter.ai/keys  (starts with sk-or-...)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# --- 4) Google Gemini — FREE tier ---
# Get a key here: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest

# To change the chain order (default: ollama,glm,nvidia,openrouter,gemini):
# AI_PROVIDER_ORDER=ollama,glm,nvidia,openrouter,gemini
# To turn AI off completely:  AI_MODE=off
# Max time for one API call (ms): AI_TIMEOUT_MS=45000

# --- Other settings ---
DATABASE_URL="file:../data/pdf_qa.db"
PORT=8000
# Stop a PDF only if NO page finishes for this long (default 10 min).
# There is no total limit, so 1000+ page scanned PDFs can run for hours:
# WORKER_TIMEOUT_MS=600000
# Max size per uploaded file in MB (default 1024):
# MAX_UPLOAD_MB=1024
# On Windows the Python command is often "python":
# PYTHON_BIN=python
