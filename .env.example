# Copy karke ".env" naam se save karo aur apni keys bharo.
# Fallback chain: Ollama (local) -> GLM -> NVIDIA -> Gemini.
# Ek fail hui to dusri apne aap chalegi; sab fail to database-search jawab.
# Kuch na lagao to bhi app chalega.

# --- 0) Ollama (LOCAL, bilkul free — key nahi chahiye) ---
# Install: https://ollama.com  phir model download karo:  ollama pull qwen2.5:7b
# 24GB RAM + 6GB GPU ke liye qwen2.5:7b best hai (Hindi achhi + fast).
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_NUM_CTX=8192

# --- 1) GLM (z.ai) — FREE model glm-4.7-flash ---
# Key yahan se: https://z.ai/manage-apikey/apikey-list
GLM_API_KEY=
# GLM_MODEL=glm-4.7-flash
# GLM_BASE_URL=https://api.z.ai/api/paas/v4

# --- 2) NVIDIA NIM — FREE tier ---
# Key yahan se: https://build.nvidia.com  (Get API Key, nvapi-... se shuru)
NVIDIA_API_KEY=
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# --- 3) Google Gemini — FREE tier ---
# Key yahan se: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Chain ka order badalna ho to (default: ollama,glm,nvidia,gemini):
# AI_PROVIDER_ORDER=ollama,glm,nvidia,gemini
# AI bilkul band karna ho to:  AI_MODE=off
# Ek API call ka max time (ms): AI_TIMEOUT_MS=45000

# --- Baaki settings ---
DATABASE_URL="file:../data/pdf_qa.db"
PORT=8000
# Windows par Python command aksar "python" hota hai:
# PYTHON_BIN=python
