# Copy karke ".env" naam se save karo (zaroori nahi — defaults kaafi hain)

# Prisma/SQLite database ka path (prisma/ folder ke relative)
DATABASE_URL="file:../data/pdf_qa.db"

# Web server port
PORT=8000

# Python kis command se chale (PDF/OCR worker ke liye)
# Windows par aksar: python   |   Linux/Mac par: python3
# PYTHON_BIN=python
