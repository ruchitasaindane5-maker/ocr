// ============================================================
//  PDF OCR Q&A — Prisma ORM Schema (SQLite)
//  Models: Document -> Page, Chunk (search pieces)
//  chunks_fts (FTS5 virtual table) is not a Prisma model — it is
//  created with raw SQL on server boot. Tables can also be created with
//  `npx prisma db push`, and the server prepares them itself too
//  (server/prisma.ts -> ensureSchema).
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// An uploaded PDF
model Document {
  id          String  @id // first 12 chars of sha256
  name        String
  sha256      String  @unique
  fileSize    Int     @default(0) @map("file_size")
  pageCount   Int     @default(0) @map("page_count")
  totalChars  Int     @default(0) @map("total_chars")
  ocrEngine   String? @map("ocr_engine")
  ocrPages    Int     @default(0) @map("ocr_pages")
  tablesFound Int     @default(0) @map("tables_found")
  metadata    String  @default("{}") // JSON string (PDF metadata)
  storedFile  String? @map("stored_file")
  createdAt   String  @map("created_at") // ISO string

  pages  Page[]
  chunks Chunk[]

  @@map("documents")
}

/// Extracted text of one page (method: text | ocr:<engine> | text+ocr:<engine>)
model Page {
  id        Int      @id @default(autoincrement())
  docId     String   @map("doc_id")
  pageNo    Int      @map("page_no")
  method    String   @default("text")
  text      String   @default("")
  charCount Int      @default(0) @map("char_count")

  document Document @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@unique([docId, pageNo])
  @@index([docId])
  @@map("pages")
}

/// A piece of text cut for search (FTS5/BM25 + TF-IDF run on this)
model Chunk {
  id     Int    @id @default(autoincrement())
  docId  String @map("doc_id")
  pageNo Int    @map("page_no")
  method String @default("text")
  text   String

  document Document @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId])
  @@map("chunks")
}
