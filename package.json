{
  "name": "ocr-pdf-prisma",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "PDF OCR + Prisma Database Q&A + AI fallback chain (Ollama/GLM/NVIDIA/OpenRouter/Gemini) — PDF/OCR worker in Python",
  "engines": { "node": ">=20.19" },
  "scripts": {
    "postinstall": "prisma generate || echo \"[warn] Prisma Client was not generated — run 'npm run db:setup' (an engine download sometimes needs internet)\"",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:init": "node scripts/init-db.mjs",
    "db:setup": "prisma generate && node scripts/init-db.mjs",
    "db:studio": "prisma studio",
    "dev": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@prisma/adapter-libsql": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^18.0.10",
    "express": "^4.21.2",
    "multer": "^2.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.0",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}
